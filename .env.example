# rnk-legalhead-backend: copy to .env for local development. Never commit real values.
# In production (Render) set these as environment variables; the server refuses to start if any
# required value is missing.

NODE_ENV=development
PORT=4000

# MongoDB Atlas connection string (production: an M10+ cluster for daily backups)
MONGODB_URI=mongodb://127.0.0.1:27017/rnk-legalheads

# The website's address. Used for the origin check and the links in emails.
PUBLIC_SITE_URL=http://localhost:3000
# Optional extra allowed origins, comma-separated (defaults to PUBLIC_SITE_URL)
ALLOWED_ORIGINS=
# Shared secret with the website server (same value on both) so draft review mode can read drafts.
# At least 24 random characters. Empty = drafts are never served by the content API.
CONTENT_PREVIEW_SECRET=
# Number of proxies in front of this server (Render + the Next.js rewrite). Used for per-visitor rate limits.
TRUST_PROXY=1

# ---- Email (Brevo) ----
# "log" prints emails to the console (development only). Production must use "brevo".
MAIL_TRANSPORT=log
BREVO_API_KEY=
# Sender on a domain verified in Brevo (Senders, Domains & Dedicated IPs)
MAIL_FROM_EMAIL=website@rnklegalheads.com
MAIL_FROM_NAME=RNK Legalheads website
# Where contact enquiries and job applications are delivered
CONTACT_DESTINATION=contact@rnklegalheads.com
CAREERS_DESTINATION=contact@rnklegalheads.com
# Attach the resume to the HR email (until the CMS Applications inbox exists)
ATTACH_RESUME_TO_EMAIL=true

# ---- Newsletter (Brevo) ----
# One Brevo list per topic (the seven service groups)
NEWSLETTER_LIST_IDS={"business":3,"disputes":4,"tax":5,"property":6,"ip":7,"people":8,"regulated":9}
# Brevo double opt-in confirmation template id
DOI_TEMPLATE_ID=

# ---- Resume storage ----
# "local"      writes to LOCAL_STORAGE_DIR (development only, refused in production)
# "cloudinary" private raw files in Cloudinary (free plan is fine)  -> set CLOUDINARY_URL
# "s3"         Cloudflare R2 or AWS S3 private bucket                -> set the S3_* values
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=.data/uploads
# Cloudinary Dashboard > API Keys > "API environment variable"
CLOUDINARY_URL=
# Cloudflare R2 example: https://<account-id>.r2.cloudflarestorage.com, region "auto"
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
